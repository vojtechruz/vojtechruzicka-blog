<!doctype html>
<html lang="{{ site.lang }}">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# pageDescription (eleventyComputed) keeps this consistent with og:description, including the archived-post prefix #}
  <meta name="description" content="{{ pageDescription }}">
  <link rel="license" href="https://creativecommons.org/licenses/by/4.0/">

  {% if isLocalDevelopment %}
  <link rel="icon" href="{{ '/favicon-local.svg' | assetUrl }}" type="image/svg+xml">
  {% elif isPreview %}
  <link rel="icon" href="{{ '/favicon-preview.svg' | assetUrl }}" type="image/svg+xml">
  {% else %}
  <link rel="icon" type="image/svg+xml" href="{{ '/favicon.svg' | assetUrl }}" />
  <link rel="icon" type="image/png" href="{{ '/favicon.png' | assetUrl }}" sizes="64x64" />
  <link rel="shortcut icon" href="{{ '/favicon.ico' | assetUrl }}" />
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/apple-touch-icon.png' | assetUrl }}" />
  {% endif %}

  <meta name="apple-mobile-web-app-title" content="VR Blog" />
  {# Mobile browser toolbar colour: the header's --color-surface-1, so the bar continues the header.
     Keep in sync with theme_color in site.webmanifest (guarded by tests/manifest.test.js). #}
  <meta name="theme-color" content="#111827">
  <link rel="manifest" href="{{ '/site.webmanifest' | assetUrl }}" />
  <link rel="stylesheet" href="{{ '/styles/main.css' | assetUrl }}">
  {# No-JS fallback for the mobile nav: the stylesheet collapses the menu behind
     the hamburger by default (avoids a layout shift when nav.js loads), so
     without JS un-collapse it and hide the then-useless toggle button.
     LQIP images are unblurred by src/scripts/lqip.js once they load, which never
     happens without JS, so drop the blur and the placeholder up front. #}
  <noscript>
    <style>
      .main-navigation .nav-toggle {
        display: none !important;
      }

      .main-navigation .menu-container {
        display: flex !important;
      }

      .lqip {
        filter: none !important;
        background: none !important;
      }
    </style>
  </noscript>
  {% include "components/robots-meta.njk" %}
  <link rel="canonical" href="{{ canonicalUrl }}" />

  <title>{{metaTitle}}</title>

  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}"
    href="{{ '/feed.xml' | absoluteUrl(site.url) }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}"
    href="{{ '/atom.xml' | absoluteUrl(site.url) }}">

  {% include "components/social-metatags.njk" %}
  {% include "components/jsonld.njk" %}
  {% include "components/analytics.njk" %}
  {% block head %}{% endblock %}
</head>

<body class="{{ bodyClass or '' }}">
  <a class="skip-link" href="#content">Skip to content</a>
  {% include "components/header.njk" %}
  {# Print-only identification: the navigation and footer are hidden on paper (_print.scss).
     aria-hidden: display:none on screen anyway; keeps it out of landmark checks (axe "region"). #}
  <p class="print-header" aria-hidden="true">{{ site.title }} · {{ canonicalUrl }}</p>

  <div class="main">
    {% block content %}{% endblock %}
    <aside class="sidebar" role="complementary">
      <div class="sidebar-inner">
        {% block sidebar %}{% endblock %}
      </div>
    </aside>
  </div>

  {% include "components/footer.njk" %}

  <script src="{{ '/scripts/analytics.js' | assetUrl }}" defer></script>
  <script src="{{ '/scripts/search.js' | assetUrl }}" defer></script>
  <script src="{{ '/scripts/nav.js' | assetUrl }}" defer></script>
  <script src="{{ '/scripts/lqip.js' | assetUrl }}" defer></script>
  {% block scripts %}{% endblock %}

</body>

</html>
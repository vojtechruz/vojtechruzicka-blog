{% set current = page.url %}
<header class="main-navigation">
  <nav aria-label="Main navigation">
      <div class="navigation">
        <a class="blog-name" href="/">
          <img class="blog-logo" src="/favicon.svg" alt="" width="32" height="32" eleventy:ignore />
          <span>{{site.title}}</span>
        </a>

        <button type="button" class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
          <span class="nav-toggle-box" aria-hidden="true">
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
          </span>
        </button>

        <div class="menu-container" id="nav-menu">
          <ul class="menu-items">
            {% set isHome = (current == '/') %}
            <li>
              <a href="/" {% if isHome %}class="active" aria-current="page"{% endif %}>Home</a>
            </li>
            {% set isTopics = current.startsWith('/topics/') %}
            <li>
              <a href="/topics/" {% if isTopics %}class="active" aria-current="page"{% endif %}>Topics</a>
            </li>
            {% set isAbout = (current == '/about/') %}
            <li>
              <a href="/about/" {% if isAbout %}class="active" aria-current="page"{% endif %}>About <span class="not-small-screen">me</span></a>
            </li>
          </ul>
          {% from "components/search.njk" import renderSearch %}
          {{ renderSearch('search') }}
        </div>
      </div>
  </nav>
</header>
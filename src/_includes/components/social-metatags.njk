{#
Social Meta Tags (Open Graph + Twitter + Fediverse)
--------------------------------------------------------------
• Works with values precomputed in _data/eleventyComputed.js
• Uses:
- socialTitle (card headline; site name on the home page)
- pageDescription (description or fallback)
- pageUrl (canonical absolute URL)
- imageUrl / imageWidth / imageHeight / imageAlt (featuredImage or default)
- isPost (true for articles)
- publishedDate / modifiedDate, topics, site.person.url (article:* properties on posts)
- site.title, site.twitter, site.fediverseCreator
• Outputs OG + Twitter tags with correct type.
--------------------------------------------------------------
#}

{% set kind = 'article' if isPost else 'website' %}

<!-- Open Graph (Facebook, LinkedIn, Mastodon, Bluesky, etc.) -->
<meta property="og:type" content="{{ kind }}">
<meta property="og:title" content="{{ socialTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ imageUrl }}">
{% if imageWidth and imageHeight %}
  {# Lets crawlers lay out the card on the first fetch, before downloading the image #}
  <meta property="og:image:width" content="{{ imageWidth }}">
  <meta property="og:image:height" content="{{ imageHeight }}">
{% endif %}
{% if imageAlt %}<meta property="og:image:alt" content="{{ imageAlt }}">
{% endif %}<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:locale" content="en_US">
{% if isPost %}
  {# Article-specific Open Graph properties (og:type=article). author is a profile URL per the
     OG spec; tags mirror the post topics. Dates use the same computed values as the JSON-LD. #}
  {% if publishedDate %}<meta property="article:published_time" content="{{ publishedDate | toRfc3339 }}">
  {% endif %}{% if modifiedDate %}<meta property="article:modified_time" content="{{ modifiedDate | toRfc3339 }}">
  {% endif %}<meta property="article:author" content="{{ site.person.url }}">
  {% for topic in topics %}<meta property="article:tag" content="{{ topic }}">
  {% endfor %}
{% endif %}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ socialTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ imageUrl }}">
{% if imageAlt %}<meta name="twitter:image:alt" content="{{ imageAlt }}">
{% endif %}
{% if site.twitter %}
  <meta name="twitter:site" content="{{ site.twitter }}">
  <meta name="twitter:creator" content="{{ site.twitter }}">
{% endif %}

{# Mastodon 4.3+ author byline on preview cards. Needs the rel="me" footer link back to the
   profile (see site.social) and the domain allowlisted in Mastodon's author attribution settings. #}
{% if site.fediverseCreator %}
  <meta name="fediverse:creator" content="{{ site.fediverseCreator }}">
{% endif %}

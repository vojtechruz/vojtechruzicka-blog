/*
  # --- Security ---
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Cross-Origin-Opener-Policy: same-origin

  Content-Security-Policy:
    upgrade-insecure-requests;
    default-src 'self';
    base-uri 'self';
    form-action 'self';
    frame-ancestors 'none';
    object-src 'none';
    img-src 'self' data:;
    font-src 'self';
    style-src 'self';
    # Web assembly eval is needed by Pagefind
    script-src 'self' 'wasm-unsafe-eval' https://plausible.io https://giscus.app;
    connect-src 'self' https://plausible.io;
    frame-src https://www.youtube.com https://www.youtube-nocookie.com https://codepen.io https://giscus.app;
    media-src 'self'

/styles/giscus-theme.css
  Access-Control-Allow-Origin: https://giscus.app

  # --- Allow performance monitoring tools too see detailed metrics ---
  Timing-Allow-Origin: *

/*.html
  # Ensure HTML revalidates (fresh content after deploys)
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/archives
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  # Let search engines cache for a bit, but not forever
  Cache-Control: public, max-age=3600

/rss.xml
  Cache-Control: public, max-age=300
/atom.xml
  Cache-Control: public, max-age=300
/feed.xml
  Cache-Control: public, max-age=300

/robots.txt
  Cache-Control: public, max-age=86400

# --- Long-cache immutable assets ---
# Only assets whose URL changes with their content may be cached as immutable:
#  - responsive images generated by eleventy-img carry a content hash in the filename
#  - CSS/JS live under stable filenames, but every reference goes through the
#    assetUrl filter (config/utils/asset-version.js) which appends ?v=<content hash>,
#    so each new version is requested under a new URL
# Anything else (favicons, site.webmanifest, share images at the site root) must NOT
# be immutable - browsers and CDNs would keep the old version forever after a deploy.

# Generated post/page images (content-hashed filenames in nested folders).
# Cross-Origin-Resource-Policy overrides the site-wide same-origin default: images on a
# public blog must be embeddable cross-origin (social preview tools, feed readers).
/*/*.avif
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
/*/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
/*/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
/*/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
/*/*.png
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
/*/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin

# Per-post social share image (og:image) — stable URL, regenerated when the featured
# image changes, so it must NOT be immutable (overrides the /*/*.jpg rule above)
/*/og-image.jpg
  Cache-Control: public, max-age=3600
  Cross-Origin-Resource-Policy: cross-origin

# Compiled stylesheets and script bundles (?v= versioned references)
/styles/*
  Cache-Control: public, max-age=31536000, immutable
/scripts/*
  Cache-Control: public, max-age=31536000, immutable

# --- Root-level static files (stable URLs, no content hash) ---
# Fetched under their bare URL by browsers (automatic favicon lookup, manifest icons)
# and scrapers (og:image), so they need a short cache to pick up changes after deploys.
/favicon.ico
  Cache-Control: public, max-age=3600
  Cross-Origin-Resource-Policy: cross-origin
/favicon.svg
  Cache-Control: public, max-age=3600
  Cross-Origin-Resource-Policy: cross-origin
/favicon.png
  Cache-Control: public, max-age=3600
  Cross-Origin-Resource-Policy: cross-origin
/favicon-local.svg
  Cache-Control: public, max-age=3600
/favicon-preview.svg
  Cache-Control: public, max-age=3600
/apple-touch-icon.png
  Cache-Control: public, max-age=3600
  Cross-Origin-Resource-Policy: cross-origin
/site.webmanifest
  Cache-Control: public, max-age=3600
/web-app-manifest-192x192.png
  Cache-Control: public, max-age=3600
/web-app-manifest-512x512.png
  Cache-Control: public, max-age=3600
/web-app-manifest-maskable-192x192.png
  Cache-Control: public, max-age=3600
/web-app-manifest-maskable-512x512.png
  Cache-Control: public, max-age=3600
/default-share.jpg
  Cache-Control: public, max-age=3600
  Cross-Origin-Resource-Policy: cross-origin
/vojtech.jpg
  Cache-Control: public, max-age=3600
  Cross-Origin-Resource-Policy: cross-origin
---
permalink: /atom.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title>{{ site.title }}</title>
  <link href="{{ site.url }}/" />
  <link rel="self" type="application/atom+xml" href="{{ '/atom.xml' | absoluteUrl(site.url) }}" />
  <updated>{{ collections.posts | latestModifiedDate(feeds.minDate) | toRfc3339 }}</updated>
  <id>{{ site.url }}/</id>
  <subtitle>{{ site.description }}</subtitle>
  <generator>Eleventy</generator>
  <icon>{{ feeds.icon | absoluteUrl(site.url) }}</icon>
  <author>
    <name>{{ site.author }}</name>
    <uri>{{ site.url }}/about/</uri>
  </author>

  {% for post in collections.posts %}
  {% if post.date >= feeds.minDate %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ post.url | absoluteUrl(site.url) }}" />
    <id>{{ post.url | absoluteUrl(site.url) }}</id>
    <published>{{ post.date | toRfc3339 }}</published>
    <updated>{{ post.data.modifiedDate | toRfc3339 }}</updated>
    {% for topic in post.data.topics %}
    <category term="{{ topic }}" />
    {% endfor %}

    {% set body = (post.data.description or post.templateContent) | feedContent | htmlToAbsoluteUrls(site.url) %}
    <summary type="html"><![CDATA[{{ post.data.excerpt }}]]></summary>
    <content type="html"><![CDATA[{{ (body + (post.url | feedFooter)) | safe }}]]></content>
  </entry>
  {% endif %}
  {% endfor %}
</feed>

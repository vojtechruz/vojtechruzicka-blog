{
  "name": "vojtech-ruzicka-blog",
  "version": "2.0.0",
  "description": "Vojtech Ruzicka's Programming Blog",
  "main": "N/A",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "npx cross-env ELEVENTY_RUN_MODE=serve eleventy --serve --incremental",
    "start:no-drafts": "npx cross-env INCLUDE_DRAFTS=none eleventy --serve",
    "clean": "rimraf _site",
    "prebuild": "node config/install-chromium.js",
    "build": "npm run clean && node scripts/image-cache.mjs restore && npx eleventy && node scripts/image-cache.mjs save",
    "prebuild:with-drafts": "node config/install-chromium.js",
    "build:with-drafts": "npm run clean && node scripts/image-cache.mjs restore && npx cross-env INCLUDE_DRAFTS=all eleventy && node scripts/image-cache.mjs save && npm run search-index",
    "postbuild": "npm run search-index",
    "search-index": "pagefind --site _site",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run validate:html && npm run validate:css && npm run validate:js && npm run validate:md  && npm run validate:xml",
    "validate:html": "html-validate \"_site/**/*.html\"",
    "validate:css": "stylelint \"src/styles/**/*.scss\"",
    "validate:js": "eslint .",
    "validate:md": "markdownlint-cli2",
    "validate:xml": "node scripts/validate-xml.mjs",
    "validate:links": "cd _site && linkinator . --retry-errors --config ../linkinator.config.json",
    "validate:links:external": "cd _site && linkinator . --retry-errors --config ../linkinator.config.external.json",
    "format": "npm run format:md && npm run format:css && npm run format:js",
    "format:md": "prettier --write \"**/*.md\"",
    "format:css": "prettier --write \"**/*.scss\"",
    "format:js": "prettier --write \"**/*.js\"",
    "lighthouse": "lhci autorun"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vojtechruz/vojtechruzicka-blog.git"
  },
  "keywords": [
    "blog",
    "programming"
  ],
  "author": "Vojtech Ruzicka",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vojtechruz/vojtechruzicka-blog/issues"
  },
  "homepage": "https://github.com/vojtechruz/vojtechruzicka-blog#readme",
  "type": "module",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^6.0.4",
    "@11tyrocks/eleventy-plugin-sass-lightningcss": "^1.3.0",
    "@shikijs/markdown-it": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "cheerio": "^1.2.0",
    "eleventy-plugin-nesting-toc": "^1.3.0",
    "esbuild": "^0.28.2",
    "ffprobe-static": "^3.1.0",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "mermaid-isomorphic": "^3.1.0",
    "playwright": "^1.62.1",
    "sharp": "^0.33.5",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@xmldom/xmldom": "^0.9.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "gray-matter": "^4.0.3",
    "html-validate": "^11.7.0",
    "jsdom": "^30.0.1",
    "linkinator": "^8.0.4",
    "markdownlint-cli2": "^0.23.2",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@img/sharp-win32-x64@0.35.1": true,
    "@parcel/watcher@2.6.0": false,
    "esbuild@0.28.2": true,
    "sharp@0.33.5": true
  }
}

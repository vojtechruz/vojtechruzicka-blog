# The Obsidian toolchain reads/writes local vault files — no API tokens needed.
# These are all OPTIONAL overrides; the defaults in config.py match the current
# vault layout, so you normally don't need a .env at all.

# Vault root (default: D:\Dropbox\Obsidian)
# OBSIDIAN_VAULT=D:\Dropbox\Obsidian

# Blog databases (default: <vault>\Oblasti\Blog\Blog Ideas and ...\Blog Articles)
# OBSIDIAN_IDEAS_DIR=D:\Dropbox\Obsidian\Oblasti\Blog\Blog Ideas
# OBSIDIAN_ARTICLES_DIR=D:\Dropbox\Obsidian\Oblasti\Blog\Blog Articles

# Learning list (default: <vault>\__INBOX\Notion\KB\Learning Tracker)
# OBSIDIAN_LEARNING_DIR=D:\Dropbox\Obsidian\__INBOX\Notion\KB\Learning Tracker

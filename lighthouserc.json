{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "url": [
        "http://localhost/index.html",
        "http://localhost/break-java-generics-naming-convention/",
        "http://localhost/about/",
        "http://localhost/topics/java/",
        "http://localhost/documenting-angular-apps-with-typedoc-compodoc-and-angulardoc/",
        "http://localhost/404.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.8 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/404\\.html$).*",
          "assertions": {
            "categories:seo": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "/404\\.html$",
          "assertions": {
            "document-title": "error",
            "meta-description": "error",
            "link-text": "error",
            "crawlable-anchors": "error",
            "robots-txt": "error",
            "hreflang": "error",
            "canonical": "error"
          }
        }
      ]
    },
    "upload": {
      "target": "temporary"
    }
  }
}
